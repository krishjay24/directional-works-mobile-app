{
  "expo": {
    "name": "Directional Works",
    "slug": "directional-works",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-icon.png",
    "scheme": "directional-works",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#12100E",
        "foregroundImage": "./assets/brand-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.directionalworks.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-logo.png",
          "resizeMode": "contain",
          "imageWidth": 260,
          "backgroundColor": "#F8F6F1",
          "dark": {
            "image": "./assets/brand-logo.png",
            "backgroundColor": "#12100E"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Directional Works to access your camera.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Directional Works to select photos.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-sharing",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
